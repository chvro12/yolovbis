{
  "name": "parking-capacity",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash scripts/setup_codespace.sh",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Gradio UI",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "remoteEnv": {
    "PARKING_CAPACITY_REPO": "${containerWorkspaceFolder}"
  }
}
